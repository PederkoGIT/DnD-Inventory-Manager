<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DnD_InventoryManager.ViewModels"
             xmlns:models="clr-namespace:DnD_InventoryManager.Models"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="DnD_InventoryManager.Views.QrScanPage"
             x:DataType="vm:QrScanViewModel"
             Title="{Binding Title}"
             BackgroundColor="Black">

    <Grid>
        <zxing:CameraBarcodeReaderView x:Name="CameraView"
                                       BarcodesDetected="CameraView_BarcodesDetected"
                                       IsDetecting="{Binding IsDetecting}"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border WidthRequest="260"
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Background="Transparent"
                    Stroke="White"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 Margin="24,0,24,60"
                                 Spacing="15">

                <Border Padding="16,10"
                        BackgroundColor="#CC000000"
                        Stroke="#33FFFFFF"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           TextColor="White"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </Border>

                <ImageButton Source="gallery.png" 
                             WidthRequest="54" HeightRequest="54" CornerRadius="27" Padding="14"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceLight}}" 
                             Command="{Binding PickFromGalleryCommand}" ToolTipProperties.Text="Gallery select"/>
            </VerticalStackLayout>
        </Grid>

        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsItemPreviewVisible}" ZIndex="101">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelItemPreviewCommand}" />
            </Grid.GestureRecognizers>
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="25,20" WidthRequest="340" StrokeThickness="0">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Incoming Item" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border HeightRequest="100" WidthRequest="100" Stroke="{StaticResource Primary}" StrokeThickness="2" HorizontalOptions="Center" Margin="0,0,0,5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Image Source="{Binding PreviewSelectedImage}" Aspect="AspectFill" />
                        </Border>
                        <Label Text="{Binding PreviewItem.Name}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{Binding PreviewItem.Category}" FontSize="12" FontAttributes="Bold" TextTransform="Uppercase" TextColor="{StaticResource Secondary}" />
                            <Label Text="•" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Label Text="{Binding PreviewItem.Weight, StringFormat='{0} lb'}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SELECT ICON" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PreviewTemplateImages}" Spacing="15" HorizontalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TemplateImageItem">
                                    <Border HeightRequest="50" WidthRequest="50" StrokeThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QrScanViewModel}}, Path=SelectTemplateImageCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="{Binding ImagePath}" Margin="8" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="ASSIGN TO CHARACTER" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" BackgroundColor="Transparent" Padding="15,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCharacterSelectCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" HeightRequest="44">
                                <Label Grid.Column="0" Text="{Binding PreviewSelectedCharacter.Name}" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Label Grid.Column="1" Text="▼" VerticalOptions="Center" TextColor="{StaticResource Primary}" FontSize="12" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ASSIGN TO CATEGORY" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" BackgroundColor="Transparent" Padding="15,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPreviewCategorySelectCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" HeightRequest="44">
                                <Label Grid.Column="0" Text="{Binding PreviewSelectedCategory}" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Label Grid.Column="1" Text="▼" VerticalOptions="Center" TextColor="{StaticResource Primary}" FontSize="12" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,0">
                        <Button Grid.Column="0" Text="Discard" Command="{Binding CancelItemPreviewCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                        <Button Grid.Column="1" Text="Accept" Command="{Binding ConfirmItemPreviewCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsCharacterSelectVisible}" ZIndex="102">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCharacterSelectCommand}" />
            </Grid.GestureRecognizers>
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="25,30" WidthRequest="320" StrokeThickness="0">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Select Character" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" HorizontalOptions="Center" Margin="0,0,0,10" />
                    
                    <ScrollView MaximumHeightRequest="250">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characters}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CharacterModel">
                                    <Button Text="{Binding Name}" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QrScanViewModel}}, Path=SelectCharacterCommand}" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                                            TextColor="{StaticResource Primary}" 
                                            CornerRadius="14" FontAttributes="Bold" HeightRequest="48"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,10"/>
                    <Button Text="Cancel" Command="{Binding CloseCharacterSelectCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" FontAttributes="Bold" HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsPreviewCategorySelectVisible}" ZIndex="103">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePreviewCategorySelectCommand}" />
            </Grid.GestureRecognizers>
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="25,30" WidthRequest="320" StrokeThickness="0">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Select Category" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" HorizontalOptions="Center" Margin="0,0,0,10" />
                    
                    <ScrollView MaximumHeightRequest="250">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviewAvailableCategories}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Text="{Binding .}" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QrScanViewModel}}, Path=SelectPreviewCategoryCommand}" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" 
                                            TextColor="{StaticResource Primary}" 
                                            CornerRadius="14" FontAttributes="Bold" HeightRequest="48"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,10"/>
                    <Button Text="Cancel" Command="{Binding ClosePreviewCategorySelectCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" FontAttributes="Bold" HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>